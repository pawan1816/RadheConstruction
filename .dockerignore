# ============================================================
# BuildRanchi Pro — Docker Ignore
# Excludes unnecessary files from Docker build context
# ============================================================

# Git
.git
.gitignore

# Python
__pycache__
*.pyc
*.pyo
*.pyd
.Python
*.egg-info
dist/
build/
*.egg
.venv
venv/
env/

# Node
frontend/node_modules
frontend/dist
frontend/.env

# IDE
.vscode
.idea
*.swp
*.swo

# Project-specific
.drytis/
.playwright-mcp/
userDocs/
*.png
*.jpg
*.webm
*.mp4
media/

# Docker (prevent recursion)
docker-compose.yml
frontend/Dockerfile
backend/Dockerfile
nginx.conf
frontend/nginx-frontend.conf

# Environment files (Render provides env vars)
backend/.env
frontend/.env

# OS
.DS_Store
Thumbs.db

# Build artifacts
backend/staticfiles/
backend/db.sqlite3